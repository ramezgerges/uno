<Page
    x:Class="UITests.Windows_UI_Xaml_Media.AcrylicBrushTests.AcrylicPathWebGpu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="White">
    <Grid Width="400" Height="400">
        <Rectangle Width="120"
                   Height="400"
                   HorizontalAlignment="Left"
                   Fill="Aqua" />
        <Rectangle Width="120"
                   Height="400"
                   HorizontalAlignment="Right"
                   Fill="Yellow" />
        <Ellipse Width="260"
                 Height="260"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.Fill>
                <AcrylicBrush FallbackColor="Green"
                              TintColor="Red"
                              TintOpacity="0.4" />
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</Page>
